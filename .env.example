# Copy to .env and fill in. Never commit .env.

# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather. Leave empty to run in checker-only mode (logs stock status, sends nothing).
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (e.g. from @userinfobot). The owner is the only one who can change settings
# (mute, reminders, which amounts are tracked) - from a private chat with the bot - and receives the
# "Amazon keeps blocking" warning. Empty = settings are read-only for everyone.
OWNER_ID=

# Optional comma-separated group/supergroup chat ids (e.g. -1001234567890).
# Empty  = open mode: anyone can use the bot in private chat and add it to any group.
# Set    = restricted mode: the bot leaves any other group/channel, and private users must be members of one
#          of these groups (the owner is always allowed).
ALLOWED_GROUPS=

# Optional invite link to your alerts group (https://t.me/+...). Enables the "share the group" buttons and /share.
GROUP_INVITE=

# Optional chat id to subscribe automatically on the very first start (before anyone sends /start).
CHAT_ID=

# Optional fallback for the bot's @username (normally auto-detected via getMe). Without the @.
BOT_USERNAME=

# --- Amazon polling -----------------------------------------------------------
# Seconds between check cycles (min 60, default 300). Please keep it gentle.
POLL_SECONDS=300
# Max attempts per product per cycle while Amazon returns its robot page (default 3).
CHECK_ATTEMPTS=3
# Optional proxy used ONLY for Amazon requests, e.g. socks5h://user:pass@proxy.example.com:1080
AMAZON_PROXY=

# --- Misc ------------------------------------------------------------------
# IANA timezone for times shown in messages (default Asia/Jerusalem).
BOT_TIMEZONE=Asia/Jerusalem
# Optional: folder for state.json, bot.log, amazon_cookies.json and products.json
# (default: the "data" folder next to bot.py).
# DATA_DIR=
# Optional: path to products.json (default: <data folder>/products.json).
# PRODUCTS_FILE=
